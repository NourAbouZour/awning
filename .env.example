# ------------------------------------------------------------------
# Awning — environment variables
# Copy this file to .env and fill in each value.
# NOTE: The current build is UI-only (mock data). These variables are
# documented ahead of the backend phase; none are required to run the
# UI preview with `npm run dev`.
# ------------------------------------------------------------------

# --- App ---
# The public URL of the platform (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Root domain used for storefront subdomains (yourshop.<domain>).
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# --- Database (PostgreSQL + Prisma) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/awning"

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Stripe (test mode) ---
# Keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret from `stripe listen` or the dashboard.
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- UploadThing (image uploads) ---
# From https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# --- Resend (transactional email) ---
# From https://resend.com/api-keys
RESEND_API_KEY=""
# The From address for order confirmations and contact messages.
EMAIL_FROM="Awning <orders@yourdomain.com>"
