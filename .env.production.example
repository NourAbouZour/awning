# Awning — production environment
# Copy to .env (or set these in your host's dashboard) and fill in real values.

# --- App ---
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_ROOT_DOMAIN="yourdomain.com"

# --- Database (MySQL) ---
# Point at your production MySQL (hosted provider or your VPS).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/awning"

# --- Auth --- (generate: openssl rand -base64 32)
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"

# --- Email sending (turns on real campaigns) ---
# Your Hostinger email mailbox provides these.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="you@yourdomain.com"
SMTP_PASS="your-mailbox-password"
EMAIL_FROM="you@yourdomain.com"
